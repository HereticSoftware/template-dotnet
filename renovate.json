{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": {
    "enabled": false
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchFileNames": ["global.json"],
      "addLabels": ["dotnet-sdk"]
    },
    {
      "matchPackageNames": ["Microsoft.Extensions.*"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "matchPackageNames": ["Microsoft.Extensions.*"],
      "matchUpdateTypes": ["major"],
      "groupName": "Microsoft platform packages"
    }
  ]
}
